{
  "schema_version": 1,
  "template": {
    "id": "style:feedly-reader",
    "source": "https://prompts.aiplanet.live/api/webui/v1/templates/feedly-reader.json",
    "sha256": "4efd666788f4963e307ced19a99800d7b8f9bc716909bd4a5196f8107982f487"
  },
  "rules": [
    {
      "id": "canvas",
      "role": "body",
      "kind": "style",
      "source": "theme.tokens.canvas / FR-V01",
      "description": "公开浅色白色画布",
      "property": "background-color",
      "expected": "rgb(255, 255, 255)"
    },
    {
      "id": "accent",
      "role": "root",
      "kind": "style",
      "source": "theme.tokens.accent / FR-V01",
      "description": "共用克制绿色",
      "property": "--accent",
      "expected": "#187b3c"
    },
    {
      "id": "border",
      "role": "root",
      "kind": "style",
      "source": "theme.tokens.border / FR-V01",
      "description": "共用浅灰分隔",
      "property": "--line",
      "expected": "#e8e8e8"
    },
    {
      "id": "viewport",
      "role": "root",
      "kind": "no-horizontal-overflow",
      "source": "FR-V05",
      "description": "整页不横向溢出"
    },
    {
      "id": "feed-title",
      "role": "feed-title",
      "kind": "style",
      "source": "theme.tokens.font_size_px.item_title / FR-V02",
      "description": "信息流标题16px",
      "property": "font-size",
      "expected": "16px"
    },
    {
      "id": "feed-shadow",
      "role": "feed",
      "kind": "style",
      "source": "components.信息条目 / FR-V03",
      "description": "信息流常态无卡片阴影",
      "property": "box-shadow",
      "expected": "none"
    },
    {
      "id": "feed-reading",
      "role": "feed",
      "kind": "manual",
      "source": "FR-V02 / FR-V03 / FR-V05",
      "description": "长短标题自然换行，标题→来源→两行摘要；X保留作者→原帖；媒体左置，小图比例、无图释放空间，推荐理由及日期轻量分组"
    },
    {
      "id": "detail-reading",
      "role": "detail",
      "kind": "manual",
      "source": "components.详情与长文 / FR-V05",
      "description": "详情标题、导读或正文、引用及图片完整可读，无图不留空槽"
    },
    {
      "id": "interaction",
      "role": "body",
      "kind": "manual",
      "source": "FR-V04 / FR-V06",
      "description": "首页筛选、展开、收藏、详情入口、焦点及浅深切换保留业务语义"
    },
    {
      "id": "ranking-surface",
      "role": "ranking",
      "kind": "style",
      "source": "FR-V08",
      "description": "排行没有装饰渐变",
      "property": "background-image",
      "expected": "none"
    },
    {
      "id": "metric-size",
      "role": "metric",
      "kind": "style",
      "source": "FR-V08",
      "description": "主指标28px并从属于模型或事件",
      "property": "font-size",
      "expected": "28px"
    },
    {
      "id": "metric-ink",
      "role": "metric",
      "kind": "style",
      "source": "FR-V08",
      "description": "主指标中性文字",
      "property": "color",
      "expected": "rgb(51, 51, 51)"
    },
    {
      "id": "report-title",
      "role": "report-title",
      "kind": "manual",
      "source": "FR-V09",
      "description": "题头28–36px且日期完整可读，期号和往期入口保留"
    },
    {
      "id": "report-reading",
      "role": "detail",
      "kind": "manual",
      "source": "FR-V09",
      "description": "刊物正文与有图/无图布局连续可读；分栏和章节归属保持"
    },
    {
      "id": "calendar-selection",
      "role": "calendar",
      "kind": "manual",
      "source": "FR-V10",
      "description": "日期选中、今天和事件标签可区分，选择日期后对应详情与原文可展开"
    },
    {
      "id": "directory-hierarchy",
      "role": "detail",
      "kind": "manual",
      "source": "FR-V07",
      "description": "目录及归档标题先于辅助数量，长名称和导航入口可读"
    },
    {
      "id": "compound-context",
      "role": "detail",
      "kind": "manual",
      "source": "FR-V11",
      "description": "引用、进展、证据展开保留主内容归属，辅助层级克制"
    },
    {
      "id": "utility-reading",
      "role": "detail",
      "kind": "manual",
      "source": "FR-V12 / FR-V14",
      "description": "说明页文字层级和控件关联清楚，代码局部滚动与状态提示可读"
    }
  ]
}
