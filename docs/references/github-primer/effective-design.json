{
  "schema_version": 1,
  "template": {
    "id": "style:github-primer-product-ui",
    "source": "https://prompts.aiplanet.live/api/webui/v1/templates/github-primer-product-ui.json",
    "sha256": "67b484c8c1641c9e2e5114f0a60cb717c64fa0d3c5a8c7a0eeeafc818904d88f"
  },
  "rules": [
    {
      "id": "canvas",
      "role": "body",
      "kind": "style",
      "source": "theme.tokens.light.canvas / GH-V01",
      "description": "白色画布",
      "property": "background-color",
      "expected": "rgb(255, 255, 255)"
    },
    {
      "id": "text",
      "role": "body",
      "kind": "style",
      "source": "theme.tokens.light.text / GH-V01",
      "description": "正文 #1f2328",
      "property": "color",
      "expected": "rgb(31, 35, 40)"
    },
    {
      "id": "body-size",
      "role": "body",
      "kind": "style",
      "source": "theme.tokens.font_size_px.body / GH-V02",
      "description": "正文 14px",
      "property": "font-size",
      "expected": "14px"
    },
    {
      "id": "accent",
      "role": "root",
      "kind": "style",
      "source": "theme.tokens.light.accent / GH-V01",
      "description": "强调色 #0969da",
      "property": "--accent",
      "expected": "#0969da"
    },
    {
      "id": "border",
      "role": "root",
      "kind": "style",
      "source": "theme.tokens.light.border / GH-V01",
      "description": "边线 #d1d9e0",
      "property": "--line",
      "expected": "#d1d9e0"
    },
    {
      "id": "viewport",
      "role": "root",
      "kind": "no-horizontal-overflow",
      "source": "GH-V08 / GH-V14",
      "description": "整页不横向溢出"
    },
    {
      "id": "type-scale",
      "role": "text-all",
      "kind": "allowed-values",
      "property": "font-size",
      "own_text": true,
      "allowed": [
        "12px",
        "14px",
        "16px",
        "20px",
        "24px",
        "32px"
      ],
      "source": "theme.tokens.font_size_px / GH-V02",
      "description": "全页可见文字只用六档字号；行内代码、头像首字母与品牌字标按 GH-V02 例外排除"
    },
    {
      "id": "tracking",
      "role": "text-all",
      "kind": "allowed-values",
      "property": "letter-spacing",
      "own_text": true,
      "allowed": [
        "normal",
        "0px"
      ],
      "source": "GH-V02",
      "description": "标题、数字与大写小标签都不加正负字距；品牌字标排除"
    },
    {
      "id": "text-color",
      "role": "text-all",
      "kind": "allowed-values",
      "property": "color",
      "own_text": true,
      "allowed": [
        "rgb(31, 35, 40)",
        "rgb(89, 99, 110)",
        "rgb(37, 41, 46)",
        "rgb(255, 255, 255)",
        "rgb(9, 105, 218)",
        "rgb(5, 80, 174)",
        "rgb(26, 127, 55)",
        "rgb(154, 103, 0)",
        "rgb(209, 36, 47)",
        "rgb(130, 80, 223)",
        "rgb(129, 139, 152)"
      ],
      "source": "theme.tokens.light / GH-V01",
      "description": "文字颜色只用模板文字、强调与语义色；按钮字 #25292e 与反白字计入"
    },
    {
      "id": "radius",
      "role": "all",
      "kind": "allowed-values",
      "property": "border-top-left-radius",
      "allowed": [
        "0px",
        "3px",
        "5px",
        "6px",
        "12px",
        "999px",
        "9999px",
        "3.35544e+07px",
        "50%"
      ],
      "source": "theme.tokens.radius_px / GH-V03 / GH-V04",
      "description": "圆角只用 3/6/12px 与 pill；5px 为 6px 分段轨道内的同心选中块（项目适配）"
    },
    {
      "id": "control-height",
      "role": "controls-all",
      "kind": "allowed-values",
      "property": "height",
      "allowed": [
        "28px",
        "32px",
        "40px"
      ],
      "source": "components.按钮与图标按钮 / components.搜索、筛选与表单 / GH-V04",
      "description": "按钮、输入与搜索框宽窄屏都只用 28/32/40px"
    },
    {
      "id": "headings",
      "role": "headings",
      "kind": "predicate",
      "source": "components.正文与代码 / GH-V02",
      "description": "可见 h1–h3 字重不超过 600"
    },
    {
      "id": "controls",
      "role": "controls",
      "kind": "predicate",
      "source": "components.按钮与图标按钮 / GH-V04",
      "description": "按钮、输入、选择与切换项圆角不超过 6px"
    },
    {
      "id": "primary",
      "role": "primary",
      "kind": "predicate",
      "source": "components.按钮与图标按钮 / GH-V04",
      "description": "主动作为 #1f883d"
    },
    {
      "id": "labels",
      "role": "labels",
      "kind": "predicate",
      "source": "components.标签、计数与状态 / GH-V05",
      "description": "语义标签为描边 pill、透明底"
    },
    {
      "id": "underline",
      "role": "underline",
      "kind": "predicate",
      "source": "components.页内导航与分段 / GH-V06",
      "description": "页面级切换当前项 2px #fd8c73 下划线"
    },
    {
      "id": "selected-chip",
      "role": "selected-chip",
      "kind": "style",
      "property": "background-color",
      "expected": "rgb(9, 105, 218)",
      "source": "components.按钮与图标按钮 / GH-V06",
      "description": "选中的筛选、日期与期次 chip 用蓝色选中样式，不是绿色主按钮"
    },
    {
      "id": "nav-current",
      "role": "nav-current",
      "kind": "predicate",
      "source": "components.应用框架与侧栏导航 / GH-V07",
      "description": "导航当前项 600 字重"
    },
    {
      "id": "feed-card",
      "role": "feed",
      "kind": "predicate",
      "source": "components.信息流事件卡 / GH-V03",
      "description": "宽屏事件卡 1px 边线 6px 圆角无位移；窄屏为分隔行无阴影"
    },
    {
      "id": "feed-title",
      "role": "feed-title",
      "kind": "style",
      "source": "components.信息流事件卡 / GH-V03",
      "description": "动态标题 16px",
      "property": "font-size",
      "expected": "16px"
    },
    {
      "id": "ranking-surface",
      "role": "ranking",
      "kind": "style",
      "source": "components.数据表与排行 / GH-V08",
      "description": "排行无装饰渐变",
      "property": "background-image",
      "expected": "none"
    },
    {
      "id": "rank-neutral",
      "role": "rank-neutral",
      "kind": "predicate",
      "source": "components.数据表与排行 / GH-V08",
      "description": "名次中性色"
    },
    {
      "id": "metric-ink",
      "role": "metric",
      "kind": "style",
      "source": "components.指标、图表与热度格 / GH-V08",
      "description": "主指标中性文字",
      "property": "color",
      "expected": "rgb(31, 35, 40)"
    },
    {
      "id": "admin-card",
      "role": "admin-card",
      "kind": "style",
      "source": "components.管理后台与设置页 / GH-V13",
      "description": "后台 Box 6px 圆角",
      "property": "border-top-left-radius",
      "expected": "6px"
    },
    {
      "id": "admin-head",
      "role": "admin-head",
      "kind": "style",
      "source": "components.管理后台与设置页 / GH-V13",
      "description": "后台 Box 头部 #f6f8fa",
      "property": "background-color",
      "expected": "rgb(246, 248, 250)"
    },
    {
      "id": "admin-nav-current",
      "role": "admin-nav-current",
      "kind": "style",
      "source": "components.应用框架与侧栏导航 / GH-V07 / GH-V13",
      "description": "后台导航当前项中性底",
      "property": "background-color",
      "expected": "rgba(129, 139, 152, 0.15)"
    },
    {
      "id": "feed-reading",
      "role": "feed",
      "kind": "manual",
      "source": "GH-V03 / GH-V05",
      "description": "来源/时间、标题、摘要、标签、进展与推荐理由在同一事件卡中可读；有图无图、新闻与 X 条目各自成立"
    },
    {
      "id": "detail-reading",
      "role": "detail",
      "kind": "manual",
      "source": "components.正文与代码 / GH-V02",
      "description": "详情标题、导读或正文、引用、代码与图片完整可读，阅读原文入口可达"
    },
    {
      "id": "report-reading",
      "role": "detail",
      "kind": "manual",
      "source": "components.刊物与报告页 / GH-V10",
      "description": "刊头收敛为发布卡式层级，期号、日期、分栏和往期入口保留"
    },
    {
      "id": "ranking-reading",
      "role": "detail",
      "kind": "manual",
      "source": "GH-V08",
      "description": "排行、表格与指标保留列、单位与未知标记，名次中性"
    },
    {
      "id": "calendar-reading",
      "role": "detail",
      "kind": "manual",
      "source": "components.指标、图表与热度格 / GH-V09",
      "description": "日历/时间轴区分今天、选中与业务事件，选择日期后详情可读"
    },
    {
      "id": "overlay-ops",
      "role": "body",
      "kind": "manual",
      "source": "components.浮层：菜单、对话框与提示 / GH-V11",
      "description": "菜单、海报弹窗等浮层宽窄屏可打开、可关闭"
    },
    {
      "id": "forms-states",
      "role": "detail",
      "kind": "manual",
      "source": "components.搜索、筛选与表单 / components.空态、加载与提示条 / GH-V12",
      "description": "表单、代码、空/忙/错误状态层级清楚，禁用与反馈可辨"
    },
    {
      "id": "interaction",
      "role": "body",
      "kind": "manual",
      "source": "GH-V06 / GH-V07 / GH-V14",
      "description": "导航、筛选、展开、收藏、切换与键盘焦点保持原业务语义"
    },
    {
      "id": "admin-reading",
      "role": "detail",
      "kind": "manual",
      "source": "GH-V13",
      "description": "后台页头、Box、统计、表格、表单与导航层级一致可读"
    }
  ]
}
