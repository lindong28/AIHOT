# Docker Compose inputs. Private values belong in .data/wechat2rss/compose.env.
WECHAT2RSS_ENV_FILE=/absolute/path/to/AIHOT/.data/wechat2rss/service.env
WECHAT2RSS_DATA_DIR=/absolute/path/to/AIHOT/.data/wechat2rss/data
# Optional native notification destination; do not copy another service's identity blindly.
WECHAT2RSS_BOT_WEBHOOK_URL=
