NODE_ENV=production
AIHOT_ENVIRONMENT=production
DATABASE_URL=postgres://aihot:REPLACE@127.0.0.1:5432/aihot
AIHOT_DATA_DIR=/home/ubuntu/aihot/shared/data
SITE_URL=https://news.aiplanet.live
API_HOST=127.0.0.1
API_PORT=3001
API_BASE_URL=http://127.0.0.1:3001
TRUST_PROXY=true
ADMIN_PASSWORD=REPLACE_WITH_GENERATED_SECRET
SESSION_SECRET=REPLACE_WITH_GENERATED_SECRET
IMG_PROXY_SIGN_SECRET=REPLACE_WITH_GENERATED_SECRET
LLM_GATEWAY_URL=http://127.0.0.1:39031
LLM_GATEWAY_PROJECT=aihot
LLM_GATEWAY_MODE=stream
LLM_GATEWAY_ATTEMPT_TIMEOUT_MS=60000
# Enable the backfill timer only after the first end-to-end sample is accepted.
BACKFILL_CONCURRENCY=64
BACKFILL_MAX_ITEMS=64
BACKFILL_MAX_RUNS=4
BACKFILL_DRAIN_SECONDS=1500
LLM_MODEL=qwen3.8-flash
LLM_EXTRA_JSON={"enable_thinking":false}
PREFILTER_MODEL=default
SCORE_MODEL=glm-5.3-flash-selection
UNDERSTAND_MODEL=glm-5.3-flash
SUMMARIZE_MODEL=deepseek-v4.1-flash
STRUCTURE_MODEL=default
GROUP_MODEL=deepseek-v4.1-flash
GROUP_REVIEW_MODEL=deepseek-v4.1-flash
DIGEST_MODEL=deepseek-v4.1-flash
REPORT_MODEL=deepseek-v4.1-flash
TRANSLATE_MODEL=deepseek-v4.1-flash
MONITOR_MODEL=deepseek-v4.1-flash
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMS=1024
EGRESS_PROXY_URL=http://127.0.0.1:39032
SOCIAL_DATA_API_KEY=
WECHAT2RSS_BASE_URL=http://127.0.0.1:18480
WECHAT2RSS_RSS_TOKEN=
# Enable only in the production runtime after readiness and billing scope are confirmed.
COLLECT_ENABLED=false
MODEL_CALLS_ENABLED=false
FEISHU_CONTENT_PUSH_ENABLED=false
FEISHU_INTERNAL_ENABLED=false
INDEXNOW_SUBMIT_ENABLED=false
