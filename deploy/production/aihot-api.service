[Unit]
Description=AI Radar API
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/aihot/current
ExecStart=/usr/local/bin/node --env-file=/home/ubuntu/aihot/shared/app.env apps/api/src/main.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
